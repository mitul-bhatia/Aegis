# Aegis Sandboxed Verification Environment
# Zero-trust container for safe exploit & regression testing
FROM python:3.11-slim

# Install minimal test dependencies and security utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pytest requests httpx

# Create isolated, unprivileged non-root user
RUN groupadd -g 10001 sandboxgroup && \
    useradd -u 10001 -g sandboxgroup -s /bin/bash -m sandboxuser

WORKDIR /workspace

# Switch to non-root
USER sandboxuser

CMD ["pytest", "-v"]
