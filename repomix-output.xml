                {state === "validating" || state === "webhook" ? (
                  <div className="h-5 w-5 rounded-full border-2 border-muted" />
                ) : state === "indexing" ? (
                  <Loader2 className="h-5 w-5 animate-spin text-primary" />
                ) : (
                  <CheckCircle2 className="h-5 w-5 text-green-500" />
