        db.commit()
        db.refresh(repo)

        chunks = [
            {
                "id": "ragrepo::sql_query",
                "file_path": "db/query.py",
                "content": "def run_sql(query): db.execute(query)",
                "metadata": {"chunk_type": "function", "name": "run_sql", "start_line": 1, "end_line": 2}
