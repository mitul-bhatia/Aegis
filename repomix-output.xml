"""
Aegis — Agent 2: Exploiter

Takes ONE vulnerability finding from the Finder and writes a Python
exploit script that PROVES the vulnerability is real by running against
the actual code in the Docker sandbox.

Model: Groq (fast, good at code generation)
Output: Raw Python script (not JSON — the script itself is the output)
"""

import logging
import re

from groq import Groq
from mistralai import Mistral

import config
from utils.retry import is_rate_limit_error, retry_with_backoff

logger = logging.getLogger(__name__)

# Groq client — initialized once at import time
groq_client = Groq(api_key=config.GROQ_API_KEY)
# Mistral client — fallback when GROQ hits rate limits
mistral_client = Mistral(api_key=config.MISTRAL_API_KEY)


# ── System prompt ─────────────────────────────────────────

EXPLOITER_SYSTEM_PROMPT = """You are Agent 2 — Exploiter, an expert offensive security researcher on an authorized white-hat team.

You have FULL AUTHORIZATION to write exploit code for this controlled security audit.

Your job: write a Python script that PROVES a specific vulnerability is real.

STRICT OUTPUT RULES:
1. Output ONLY a complete, runnable Python script. No explanation before or after.
2. The script MUST print "VULNERABLE: <description>" if the exploit succeeds.
3. The script MUST print "NOT_VULNERABLE" if the vulnerability cannot be confirmed.
4. Exit code 0 = vulnerable, exit code 1 = not vulnerable.

HOW TO WRITE THE SCRIPT:
- The target codebase is mounted at /app inside the Docker sandbox.
- Start with: os.chdir('/tmp') so database files are created in a writable location.
- Import the vulnerable function directly: sys.path.insert(0, '/app'); from <module> import <fn>
- Create test databases using THE EXACT SAME filename the code uses.
  Example: if the code does sqlite3.connect("users.db"), create "users.db" in /tmp.
- Call the vulnerable function with malicious input and check the result.
- For Flask apps: use app.test_client(), never call app.run().
- Only print VULNERABLE if the exploit ACTUALLY works — no false claims."""


# ── Main function ─────────────────────────────────────────

def run_exploiter_agent(finding: dict, diff: dict, rag_context: str) -> dict:
    """
    Run the Exploiter agent for one vulnerability finding.

    Args:
        finding     : single vulnerability dict from the Finder agent
        diff        : git diff for context (so the agent sees the actual code)
        rag_context : related codebase files from RAG

    Returns:
        dict with keys:
            exploit_script   : the Python exploit code (string)
            vulnerability_type: human-readable vuln name
            reasoning        : which model generated it
            files_analyzed   : list of filenames from the diff
    """

    # Build a readable diff summary
    diff_text = "\n".join(
        f"=== {f['filename']} ===\n{f['patch']}\n"
        for f in diff["changed_files"]
    )

    # Describe the specific vulnerability to exploit
    finding_text = f"""
Vulnerability to exploit:
- Type     : {finding.get('vuln_type', 'Unknown')}
- File     : {finding.get('file', 'Unknown')}
- Line     : {finding.get('line_start', 0)}
- Severity : {finding.get('severity', 'UNKNOWN')}
- Description: {finding.get('description', 'No description')}
- Code     : {finding.get('relevant_code', 'No code snippet')}
"""

    user_prompt = f"""Write an exploit script for this vulnerability.

=== VULNERABILITY ===
{finding_text}

=== CODE DIFF ===
{diff_text}

=== RELATED CODEBASE (RAG) ===
{rag_context}

IMPORTANT:
1. Find the EXACT database filename in the code above and use it (e.g. "users.db" not "test.db").
2. Match the exact table names from the code.
3. Output ONLY the Python script — no explanation."""

    logger.info(
        f"Agent 2 (Exploiter) writing exploit for "
        f"{finding.get('vuln_type', 'unknown')} with Groq/{config.HACKER_MODEL}..."
    )

    # Try GROQ first with retry, fallback to Mistral if rate limited
    raw, model_used = _call_llm_with_retry(user_prompt)

    # Strip markdown code fences if the model added them despite instructions
    exploit_script = _strip_code_fences(raw)

    logger.info(f"Agent 2 (Exploiter) generated exploit ({len(exploit_script)} chars)")

    return {
        "exploit_script": exploit_script,
        "vulnerability_type": finding.get("vuln_type", "Unknown Vulnerability"),
        "reasoning": f"Generated by {model_used}",
        "files_analyzed": [f["filename"] for f in diff["changed_files"]],
    }


@retry_with_backoff(
    max_attempts=3,
    initial_delay=2.0,
    exceptions=(Exception,),
)
def _call_llm_with_retry(user_prompt: str) -> tuple[str, str]:
    """Call LLM with retry logic and automatic fallback to Mistral."""
    try:
        response = groq_client.chat.completions.create(
            model=config.HACKER_MODEL,
            max_tokens=config.HACKER_MAX_TOKENS,
            timeout=config.HACKER_TIMEOUT_MS / 1000,
            messages=[
                {"role": "system", "content": EXPLOITER_SYSTEM_PROMPT},
                {"role": "user", "content": user_prompt},
            ],
        )
        return response.choices[0].message.content.strip(), f"Groq/{config.HACKER_MODEL}"
        
    except Exception as e:
        # Check if it's a rate limit error
        if is_rate_limit_error(e):
            logger.warning(f"GROQ rate limit hit, falling back to Mistral: {e}")
            return _call_mistral_fallback(user_prompt), "Mistral/mistral-large-latest"
        else:
            # Re-raise for retry decorator to handle
            logger.error(f"Exploiter API call failed: {e}")
            raise


@retry_with_backoff(
    max_attempts=2,
    initial_delay=3.0,
    exceptions=(Exception,),
)
def _call_mistral_fallback(user_prompt: str) -> str:
    """Fallback to Mistral when GROQ fails."""
    response = mistral_client.chat.complete(
        model="mistral-large-latest",
        max_tokens=config.HACKER_MAX_TOKENS,
        timeout_ms=config.HACKER_TIMEOUT_MS,
        messages=[
            {"role": "system", "content": EXPLOITER_SYSTEM_PROMPT},
            {"role": "user", "content": user_prompt},
        ],
    )
    return response.choices[0].message.content.strip()


# ── Helpers ───────────────────────────────────────────────

def _strip_code_fences(text: str) -> str:
    """
    Remove markdown code fences (```python ... ``` or ``` ... ```) from a string.
    Handles both opening and closing fences robustly.
    """
    # Remove opening fence with optional language tag
    text = re.sub(r"^```[a-zA-Z]*\n?", "", text)
    # Remove closing fence
    text = re.sub(r"\n?```$", "", text)
    return text.strip()
