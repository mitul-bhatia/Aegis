<file path="Dockerfile.backend">
FROM python:3.11-slim

WORKDIR /app

# Install only essential system dependencies (git for cloning repos, curl for health checks)
# Note: docker.io CLI is NOT needed — backend uses the Docker Python SDK
RUN apt-get update && apt-get install -y \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p repos aegis_vector_db

# NOTE: Do NOT run init_db() here — env vars (DATABASE_URL) are NOT available at
# Docker build time on Render. DB tables are created in main.py's on_startup event.

# Expose port
EXPOSE 8000

# Run application via uvicorn directly (faster startup, better signal handling)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
</file>

<file path="Dockerfile.sandbox">
FROM python:3.11-slim

# Install common dependencies for exploit testing
RUN apt-get update && apt-get install -y \
    sqlite3 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages commonly needed for exploits
# Note: sqlite3 is built into Python, no need to install
RUN pip install --no-cache-dir \
    requests \
    pytest \
    flask \
    django \
    fastapi \
    sqlalchemy

# Create non-root user for running exploits
RUN useradd -m -u 1000 sandbox && \
    mkdir -p /app /sandbox /tmp && \
    chown -R sandbox:sandbox /app /sandbox /tmp

# Set working directory
WORKDIR /app

# Switch to non-root user
USER sandbox

# Default command
CMD ["/bin/bash"]
</file>

