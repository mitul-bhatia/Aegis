function processUser(user) {
    console.log(user.name);
    return user.id;
}

const formatData = (data) => {
    return JSON.stringify(data);
}
'''
    chunks = chunk_js_ts_file(content, "app.js")
    assert len(chunks) >= 2
    names = [c["name"] for c in chunks if c["type"] == "function"]
